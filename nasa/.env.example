# ==============================================================================
# AstroCare Deep-Space Space-Medicine Decision Support System
# Unified Environment Configuration (.env.example)
# ==============================================================================

# --- APPLICATION ENVIRONMENT ---
ASTRO_ENV=dev
ASTRO_PORT=4000
ASTRO_APP_VERSION=0.1.0
ASTRO_LOG_LEVEL=info

# --- CORS & SECURITY ---
# Comma-separated list of allowed origins (never '*' with credentials)
ASTRO_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
ASTRO_COOKIE_SECURE=false

# --- MISSION PROFILE ---
# iss (~0s delay) | moon (~1.3s delay) | mars (4 - 24 min one-way light-time delay)
ASTRO_MISSION_MODE=mars

# --- DATABASE (MongoDB 7.0) ---
ASTRO_MONGODB_URI=mongodb://localhost:27017/astrocare

# --- JWT AUTHENTICATION SECRETS ---
# (In production, must be at least 32 characters long)
ASTRO_JWT_ACCESS_SECRET=dev_insecure_access_secret_min_32_chars_long!
ASTRO_JWT_REFRESH_SECRET=dev_insecure_refresh_secret_min_32_chars_long!
ASTRO_ACCESS_TOKEN_TTL=15m
ASTRO_REFRESH_TOKEN_TTL=7d

# --- TELEMETRY INGESTION & HMAC SIGNING ---
ASTRO_INGEST_API_KEY=dev_insecure_ingest_api_key_min_32_characters!
ASTRO_TELEMETRY_HMAC_SECRET=dev_telemetry_hmac_secret_min_32_characters!
ASTRO_TELEMETRY_HMAC_REQUIRED=false
ASTRO_TELEMETRY_MAX_BATCH=500
ASTRO_TELEMETRY_EXPECTED_INTERVAL_S=1
ASTRO_TELEMETRY_MAX_INTERP_GAP_S=10
ASTRO_TELEMETRY_RETENTION_DAYS=0
ASTRO_IDEMPOTENCY_TTL_H=24

# --- RATE LIMITING (Token Bucket & Redis) ---
ASTRO_RATE_LIMIT_ENABLED=true
ASTRO_RATE_LIMIT_WINDOW_S=60
ASTRO_RATE_LIMIT_MAX_REQUESTS=100
ASTRO_RATE_LIMIT_AUTH_MAX_REQUESTS=10
ASTRO_RATE_LIMIT_TELEMETRY_MAX_REQUESTS=120

# --- REAL-TIME EVENT BUS (Redis Streams & Pub/Sub) ---
ASTRO_EVENT_BUS_DRIVER=redis
ASTRO_REDIS_URL=redis://localhost:6379
ASTRO_REDIS_KEY_PREFIX=astro:
ASTRO_REDIS_REQUIRED=false
ASTRO_BUS_STREAM_MAXLEN=10000
ASTRO_BUS_REPLAY_MAX_EVENTS=1000
ASTRO_BUS_OUTBOX_MAX=1000
ASTRO_LIVE_TELEMETRY_COALESCE_MS=500
ASTRO_SOCKET_AUTH_REFRESH_WARN_S=60

# --- CLINICAL ALERT FUSION & ML SIDECAR ---
ASTRO_FUSION_ENABLED=true
ASTRO_FLAG_ML_ENABLED=true
ASTRO_ML_API_KEY=dev_insecure_ml_api_key_min_32_characters!
ASTRO_FUSION_ML_MIN_CONFIDENCE=0.5
ASTRO_FUSION_DISMISS_SUPPRESS_S=3600
ASTRO_FUSION_UPDATE_COALESCE_S=60
ASTRO_FUSION_MAX_MEMBERS=50
ASTRO_FUSION_TIMELINE_MAX=200
ASTRO_FUSION_SNOOZE_MAX_WATCH_MIN=120
ASTRO_FUSION_SNOOZE_MAX_WARNING_MIN=60
ASTRO_FUSION_SWEEP_S=10
ASTRO_FUSION_RECONCILE_ON_START=true

# --- ML SIDECAR SERVICE CONFIGURATION ---
ASTRO_BACKEND_URL=http://localhost:4000
PORT=8000
HOST=0.0.0.0

# --- SEED PASSWORDS FOR DEMO ACCOUNTS ---
ASTRO_SEED_ADMIN_PASSWORD=AdminSecret#2026
ASTRO_SEED_SURGEON_PASSWORD=SurgeonSecret#2026
ASTRO_SEED_CONTROL_PASSWORD=ControlSecret#2026
ASTRO_SEED_ASTRONAUT_PASSWORD=AstroSecret#2026
ASTRO_SEED_MEDIC_PASSWORD=MedicSecret#2026
