# AstroCare Environment Configuration
# All application variables are prefixed with ASTRO_

# Application Environment: dev | test | prod
ASTRO_ENV=dev

# HTTP Server Port
ASTRO_PORT=4000

# Application Version (semver)
ASTRO_APP_VERSION=0.1.0

# Allowed CORS Origins (comma-separated list, never "*" when credentials/cookies are active)
ASTRO_CORS_ORIGINS=http://localhost:5173

# Mission Profile: iss | moon | mars
ASTRO_MISSION_MODE=mars

# Logging Verbosity: fatal | error | warn | info | debug | trace | silent
ASTRO_LOG_LEVEL=info

# Database Connection (MongoDB)
ASTRO_MONGODB_URI=mongodb://localhost:27017/astrocare

# JWT Authentication Secrets (In production, must be at least 32 characters long)
ASTRO_JWT_ACCESS_SECRET=dev_insecure_access_secret_min_32_chars_long!
ASTRO_JWT_REFRESH_SECRET=dev_insecure_refresh_secret_min_32_chars_long!

# Token Lifetimes
ASTRO_ACCESS_TOKEN_TTL=15m
ASTRO_REFRESH_TOKEN_TTL=7d

# Cookie Security (defaults to true in prod, false otherwise)
ASTRO_COOKIE_SECURE=false

# Telemetry Ingestion API Key (for automated simulators & medical devices; min 32 chars in prod)
ASTRO_INGEST_API_KEY=dev_insecure_ingest_api_key_min_32_characters!

# Telemetry Batch & Quality Ingestion Parameters
ASTRO_TELEMETRY_MAX_BATCH=500
ASTRO_TELEMETRY_EXPECTED_INTERVAL_S=1
ASTRO_TELEMETRY_MAX_INTERP_GAP_S=10
ASTRO_TELEMETRY_RETENTION_DAYS=0
ASTRO_IDEMPOTENCY_TTL_H=24

# Feature Flags (defaults shown, can be overridden per environment)
ASTRO_FLAG_ML_ENABLED=true
ASTRO_FLAG_LLM_MODE=auto
ASTRO_FLAG_RULES_ONLY_FALLBACK=false
ASTRO_FLAG_DEMO_PANEL_ENABLED=true

# Real-Time Event Bus & Redis Configuration (F118)
ASTRO_EVENT_BUS_DRIVER=redis
ASTRO_REDIS_URL=redis://localhost:6379
ASTRO_REDIS_KEY_PREFIX=astro:
ASTRO_REDIS_REQUIRED=false
ASTRO_BUS_STREAM_MAXLEN=10000
ASTRO_BUS_REPLAY_MAX_EVENTS=1000
ASTRO_BUS_OUTBOX_MAX=1000
ASTRO_LIVE_TELEMETRY_COALESCE_MS=500
ASTRO_SOCKET_AUTH_REFRESH_WARN_S=60

# Emergency Declaration Parameters (F063)
ASTRO_EMERGENCY_DEDUPE_S=30
ASTRO_EMERGENCY_CANCEL_WINDOW_S=60

# Alert Triage, Fusion & Inbox Configuration (Part 2d)
ASTRO_FUSION_ENABLED=true
ASTRO_ML_API_KEY=dev_insecure_ml_api_key_min_32_characters!
ASTRO_FUSION_ML_MIN_CONFIDENCE=0.5
ASTRO_FUSION_DISMISS_SUPPRESS_S=3600
ASTRO_FUSION_UPDATE_COALESCE_S=2
ASTRO_FUSION_MAX_MEMBERS=50
ASTRO_FUSION_TIMELINE_MAX=200
ASTRO_FUSION_SNOOZE_MAX_WATCH_MIN=480
ASTRO_FUSION_SNOOZE_MAX_WARNING_MIN=60
ASTRO_FUSION_SWEEP_S=5
ASTRO_FUSION_RECONCILE_ON_START=true

